{
    "compilerOptions": {
        "paths": {
            "~*": ["./*"],
            "pure-rand/lib/esm/*": ["./node_modules/pure-rand/lib/esm/*"]
        },
        "strict": true,
        "strictNullChecks": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2015",
        "lib": ["ES6", "DOM"],
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "noUncheckedIndexedAccess": true
    },
    "include": ["**/**.ts", "index.ts"],
    "exclude": [".*/**", "bin-dev/**", "bin/**", "node_modules/**"]
}
